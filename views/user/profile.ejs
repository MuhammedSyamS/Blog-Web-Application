<%- include('../partials/header', { title: 'My Profile', user }) %>

<style>
:root {
  --accent: #ffd600;
  --accent-hover: #fff176;
  --card-bg: rgba(255,255,255,0.08);
  --card-border: rgba(255,255,255,0.15);
  --shadow: rgba(0,0,0,0.35);
  --text-light: #f8f8f8;
  --text-muted: rgba(255,255,255,0.7);
  --btn-primary: #4f46e5;
  --btn-primary-hover: #7c3aed;
}

body {
  background: linear-gradient(135deg, #0f172a, #1e293b);
  color: var(--text-light);
  font-family: 'Poppins', sans-serif;
  min-height: 100vh;
  padding: 2rem 1rem;
}

/* ==================== PROFILE HEADER ==================== */
.text-center h2 {
  font-weight: 800;
  font-size: 2.2rem;
  background: linear-gradient(90deg, var(--accent), var(--accent-hover));
  -webkit-background-clip: text;
   background-clip: padding;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.5rem;
}

.text-center p {
  color: var(--text-muted);
  margin-bottom: 1rem;
}

.text-center hr {
  border-color: var(--accent);
  height: 2px;
  width: 100px;
  margin: 0.5rem auto 2rem;
  border-radius: 2px;
}

/* ==================== ACCOUNT INFO CARD ==================== */
.card.account-info {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 24px;
  backdrop-filter: blur(16px);
  box-shadow: 0 20px 40px var(--shadow);
  padding: 20px;
  margin-bottom: 2.5rem;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.card.account-info:hover {
  transform: translateY(-4px);
  box-shadow: 0 25px 50px rgba(0,0,0,0.4);
}
.card.account-info .card-header {
  font-weight: 700;
  background: linear-gradient(90deg, var(--accent), var(--accent-hover));
  color: #000;
  border-radius: 20px 20px 0 0;
  font-size: 1.2rem;
  text-align: center;
}

/* ==================== ACTIVITY CARDS ==================== */
.card.activity-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 20px;
  backdrop-filter: blur(14px);
  box-shadow: 0 15px 30px var(--shadow);
  padding: 25px 15px;
  text-align: center;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.card.activity-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 25px 50px rgba(0,0,0,0.45);
}
.card.activity-card i {
  font-size: 2.8rem;
  margin-bottom: 0.5rem;
}
.card.activity-card h4 {
  margin-top: 0.3rem;
  font-weight: 700;
  font-size: 1.5rem;
}
.card.activity-card p {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* ==================== MY POSTS ==================== */
#myPostsHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}
#myPostsHeader h3 {
  font-weight: 700;
  font-size: 1.5rem;
  color: var(--accent);
}
#myPostsHeader a.btn {
  font-weight: 600;
  border-radius: 12px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
#myPostsHeader a.btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(255,214,0,0.4);
}

.card.post-card {
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: 20px;
  backdrop-filter: blur(14px);
  box-shadow: 0 15px 30px var(--shadow);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.card.post-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 25px 50px rgba(0,0,0,0.45);
}
.card.post-card h5 {
  font-weight: 700;
  color: var(--accent);
}
.card.post-card p {
  color: var(--text-muted);
}
.card.post-card .btn-outline-primary,
.card.post-card .btn-outline-warning,
.card.post-card .btn-outline-danger {
  border-radius: 12px;
  transition: all 0.25s ease;
}
.card.post-card .btn-outline-primary:hover {
  background: var(--btn-primary);
  border-color: var(--btn-primary);
  color: #fff;
}
.card.post-card .btn-outline-warning:hover {
  background: #ffd600;
  border-color: #ffd600;
  color: #000;
}
.card.post-card .btn-outline-danger:hover {
  background: #f87171;
  border-color: #f87171;
  color: #fff;
}

/* ==================== ALERT INFO ==================== */
.alert-info {
  background: var(--card-bg);
  color: var(--text-light);
  border: 1px solid var(--card-border);
  border-radius: 20px;
  backdrop-filter: blur(14px);
  box-shadow: 0 15px 30px var(--shadow);
  font-weight: 600;
}

/* ==================== RESPONSIVE ==================== */
@media(max-width: 768px) {
  .card.activity-card {
    margin-bottom: 1rem;
  }
  #myPostsHeader {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }
}
</style>

<main class="container py-5" style="max-width: 1000px;">
  <!-- Profile Header -->
  <div class="text-center mb-5">
    <h2 class="fw-bold mb-2">👤 My Profile</h2>
    <p class="text-light">Welcome back, <strong><%= user.name %></strong>!</p>
    <hr class="w-25 mx-auto">
  </div>

  <!-- Account Information -->
  <div class="card account-info mb-5">
    <div class="card-header">
      Account Information
    </div>
    <div class="card-body text-light">
      <div class="row g-3">
        <div class="col-md-6"><p><strong>Name:</strong> <%= user.name %></p></div>
        <div class="col-md-6"><p><strong>Email:</strong> <%= user.email %></p></div>
        <div class="col-md-6"><p><strong>Registered On:</strong> <%= new Date(user.createdAt).toLocaleDateString() %></p></div>
        <div class="col-md-6"><p><strong>Role:</strong> <%= user.role ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'User' %></p></div>
      </div>
    </div>
  </div>

  <!-- User Activity Summary -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card activity-card">
        <i class="bi bi-pencil-square text-primary"></i>
        <h4><%= myPosts ? myPosts.length : 0 %></h4>
        <p>Total Posts</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card activity-card">
        <i class="bi bi-heart-fill text-danger"></i>
        <h4><%= user.likedPosts ? user.likedPosts.length : 0 %></h4>
        <p>Liked Posts</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card activity-card">
        <i class="bi bi-calendar-check text-success"></i>
        <h4><%= new Date().toLocaleDateString() %></h4>
        <p>Today</p>
      </div>
    </div>
  </div>

  <!-- My Posts Section -->
  <div id="myPostsHeader">
    <h3 class="fw-semibold mb-0">📝 My Posts</h3>
    <a href="/posts/new" class="btn btn-success btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Create New Post
    </a>
  </div>

  <% if (myPosts && myPosts.length > 0) { %>
    <div class="row g-4">
      <% myPosts.forEach(function(post) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card post-card h-100">
            <div class="card-body d-flex flex-column">
              <h5 class="fw-bold mb-2"><%= post.title %></h5>
              <p class="text-muted small flex-grow-1"><%= post.content.substring(0, 120) %>...</p>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <a href="/posts/<%= post._id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i> View</a>
                <div class="btn-group">
                  <a href="/posts/edit/<%= post._id %>" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                  <form action="/posts/delete/<%= post._id %>?_method=DELETE" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Are you sure you want to delete this post?')"><i class="bi bi-trash"></i></button>
                  </form>
                </div>
              </div>
            </div>
            <div class="card-footer bg-light text small">
              Created on <%= new Date(post.createdAt).toLocaleDateString() %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="alert alert-info text-center py-4 rounded-4 shadow-sm">
      <i class="bi bi-info-circle me-2"></i> You haven’t created any posts yet. Start writing your first one!
    </div>
  <% } %>
</main>

<%- include('../partials/footer') %>
