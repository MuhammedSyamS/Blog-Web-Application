<%- include('../../partials/header', { title: 'Edit Post' }) %>

<style>
:root {
  --glass-bg: rgba(255, 255, 255, 0.08);
  --glass-border: rgba(255, 255, 255, 0.15);
  --accent: #ffd600;
  --accent-hover: #fff176;
  --btn-primary: #4f46e5;
  --btn-primary-hover: #7c3aed;
  --text-light: #f8f8f8;
  --text-muted: rgba(255,255,255,0.7);
  --card-shadow: rgba(0,0,0,0.35);
}

/* ===================== BODY ===================== */
body {
  background: linear-gradient(135deg, #0f172a, #1e293b);
  font-family: 'Poppins', sans-serif;
  color: var(--text-light);
  min-height: 100vh;
  padding: 2rem 1rem;
}

/* ===================== WRAPPER ===================== */
.create-post-wrapper {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 50px 15px;
  min-height: 100vh;
}

/* ===================== GLASS FORM ===================== */
.create-post-container {
  backdrop-filter: blur(18px);
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  border-radius: 24px;
  padding: 40px 35px;
  max-width: 700px;
  width: 100%;
  box-shadow: 0 20px 40px var(--card-shadow), inset 0 0 0 1px var(--glass-border);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.create-post-container:hover {
  transform: translateY(-5px);
  box-shadow: 0 30px 60px rgba(79,70,229,0.3), inset 0 0 0 1px var(--glass-border);
}

/* ===================== PAGE TITLE ===================== */
.page-title {
  font-weight: 800;
  text-align: center;
  font-size: 2rem;
  background: linear-gradient(90deg, var(--accent), var(--accent-hover));
  -webkit-background-clip: text;
  background-clip: padding;
  -webkit-text-fill-color: transparent;
  margin-bottom: 1rem;
  transition: filter 0.3s ease;
}
.page-title:hover {
  filter: drop-shadow(0 0 12px var(--accent));
}

.text-muted {
  text-align: center;
  margin-bottom: 25px;
  color: var(--text-muted) !important;
}

/* ===================== FORM ELEMENTS ===================== */
.form-label {
  font-weight: 600;
  color: var(--text-light);
}

.form-control {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.25);
  color: #fff;
  transition: all 0.25s ease;
}
.form-control::placeholder {
  color: var(--text-muted);
}
.form-control:focus {
  background: rgba(255,255,255,0.25);
  border-color: var(--accent);
  box-shadow: 0 0 12px rgba(255,214,0,0.3);
}

/* ===================== IMAGE PREVIEW ===================== */
.image-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 10px;
}
.image-preview img {
  width: 120px;
  height: 120px;
  object-fit: cover;
  border-radius: 10px;
  border: 2px solid rgba(255,255,255,0.2);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.image-preview img:hover {
  transform: scale(1.05);
  box-shadow: 0 8px 20px rgba(255,214,0,0.4);
}

/* ===================== BUTTONS ===================== */
.btn-primary {
  width: 100%;
  background: linear-gradient(135deg, var(--btn-primary), var(--btn-primary-hover));
  border: none;
  font-weight: 600;
  padding: 0.7rem;
  border-radius: 12px;
  transition: all 0.3s ease;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(124,58,237,0.4);
}

.btn-secondary {
  width: 100%;
  background: rgba(255,255,255,0.15);
  border: none;
  color: #fff;
  font-weight: 600;
  padding: 0.7rem;
  border-radius: 12px;
  margin-top: 10px;
  transition: all 0.3s ease;
}
.btn-secondary:hover {
  transform: translateY(-2px);
  background: rgba(255,255,255,0.25);
}

/* ===================== RESPONSIVE ===================== */
@media (max-width: 768px) {
  .create-post-container {
    padding: 30px 20px;
  }
  .page-title {
    font-size: 1.6rem;
  }
  .image-preview img {
    width: 90px;
    height: 90px;
  }
}
@media (max-width: 480px) {
  .create-post-container {
    padding: 25px 15px;
  }
  .page-title {
    font-size: 1.4rem;
  }
  .image-preview img {
    width: 70px;
    height: 70px;
  }
}
</style>

<div class="create-post-wrapper">
  <div class="create-post-container">
    <h2 class="page-title">✏️ Edit Post</h2>
    <p class="text-muted">
      Update your title, content, or images. Leave the image field empty to keep existing ones.
    </p>

    <form action="/posts/edit/<%= post._id %>" method="POST" enctype="multipart/form-data" id="editPostForm">
      <!-- Post Title -->
      <div class="mb-3">
        <label for="title" class="form-label">Post Title</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= post.title %>" required>
      </div>

      <!-- Existing Images -->
      <% if (post.images && post.images.length > 0) { %>
        <div class="mb-3">
          <label class="form-label">Current Images</label>
          <div class="image-preview">
            <% post.images.forEach(function(img){ 
                 const filename = img.split('/').pop().split('\\').pop();
            %>
              <img src="/uploads/<%= filename %>" alt="Post Image">
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- Upload New Images -->
      <div class="mb-3">
        <label for="images" class="form-label">Upload New Images (optional)</label>
        <input type="file" id="images" name="images" class="form-control" accept="image/*" multiple onchange="previewImages(event)">
        <div class="image-preview mt-3" id="imagePreview"></div>
      </div>

      <!-- Post Content -->
      <div class="mb-3">
        <label for="content" class="form-label">Post Content</label>
        <textarea id="content" name="content" class="form-control" rows="8" required><%= post.content %></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Update Post</button>
      <a href="/posts/<%= post._id %>" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>

<script>
function previewImages(event) {
  const preview = document.getElementById('imagePreview');
  preview.innerHTML = '';

  const files = event.target.files;
  if (files.length > 0) {
    Array.from(files).forEach(file => {
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = 'New Image Preview';
      img.classList.add('preview-img');
      preview.appendChild(img);
    });
  }
}
</script>

<%- include('../../partials/footer') %>
