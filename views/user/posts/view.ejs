<%- include('../../partials/header', { title: post?.title || 'Post Not Found' }) %>

<style>


/* ===================== GLOBAL THEME ===================== */
:root {
  --bg-main: linear-gradient(135deg, #0f172a, #1e293b);
  --card-bg: rgba(255, 255, 255, 0.08);
  --card-border: rgba(255,255,255,0.1);
  --accent: #ffd600;
  --accent-hover: #ffec7c;
  --like-color: #ff4d6d;
  --text-light: #f8f8f8;
  --text-muted: rgba(255,255,255,0.7);
  --scrollbar: rgba(255,255,255,0.35);
}

/* ===================== BODY ===================== */
body {
  background: var(--bg-main);
  font-family: 'Poppins', sans-serif;
  color: var(--text-light);
  min-height: 100vh;
  padding: 2rem;
}

/* ===================== MAIN CARD ===================== */
main.container {
  background: var(--card-bg);
  backdrop-filter: blur(18px);
  border-radius: 28px;
  padding: 3rem;
  margin: auto;
  max-width: 900px;
  box-shadow: 0 40px 80px rgba(0,0,0,0.5),
              inset 0 0 0 1px var(--card-border);
  animation: fadeUp 0.6s ease;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

main.container:hover {
  transform: translateY(-3px);
  box-shadow: 0 60px 100px rgba(255,214,0,0.25);
}

/* ===================== TITLE ===================== */
.post-view h2 {
  font-weight: 900;
  font-size: 2.5rem;
  background: linear-gradient(90deg, #ffd600, #ffec7c);
  -webkit-background-clip: text;
  background-clip: padding;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.5rem;
  transition: filter 0.3s ease;
}

.post-view h2:hover {
  filter: drop-shadow(0 0 12px #ffd600);
}

.text-muted {
  color: var(--text-muted) !important;
  font-size: 0.95rem;
}

/* ===================== SCROLLABLE CONTENT ===================== */
.post-content {
  max-height: 420px;
  overflow-y: auto;
  padding-right: 12px;
  margin-top: 1.8rem;
  line-height: 1.85;
  font-size: 1.08rem;
  transition: background 0.3s ease;
}

/* Scrollbar */
.post-content::-webkit-scrollbar { width: 6px; }
.post-content::-webkit-scrollbar-thumb {
  background: var(--scrollbar);
  border-radius: 10px;
}
.post-content { scrollbar-width: thin; scrollbar-color: var(--scrollbar) transparent; }

/* ===================== BUTTONS ===================== */
#likeBtn,
.comment-btn,
.btn-secondary {
  border-radius: 999px;
  transition: all 0.25s ease;
  font-weight: 600;
}

#likeBtn {
  background: linear-gradient(135deg, var(--like-color), #ff7f91);
  color: #fff;
  border: none;
  box-shadow: 0 6px 20px rgba(255,77,109,0.45);
}

#likeBtn.btn-outline-primary {
  background: transparent;
  border: 2px solid var(--like-color);
  color: var(--like-color);
}

#likeBtn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(255,77,109,0.6);
}

.comment-btn {
  background: linear-gradient(135deg, #4f46e5, #a78bfa);
  color: #fff;
  border: none;
}

.comment-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(143, 128, 255,0.5);
}

.btn-secondary {
  background: #374151;
  color: #f8f8f8;
  border: none;
}

.btn-secondary:hover {
  background: #4b5563;
  transform: translateY(-1px);
}

/* ===================== COMMENTS ===================== */
.comment-item {
  background: rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  border-radius: 16px;
  padding: 1rem;
  margin-bottom: 0.8rem;
  box-shadow: inset 0 0 0 1px var(--card-border);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.comment-item:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(255,214,0,0.25);
}

.comment-item strong {
  color: var(--accent);
}

.comment-input {
  background: rgba(255,255,255,0.14);
  border-radius: 16px;
  color: #fff;
  border: 1px solid rgba(255,255,255,0.25);
  transition: all 0.25s ease;
}

.comment-input:focus {
  background: rgba(255,255,255,0.22);
  border-color: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  outline: none;
}

/* ===================== ANIMATIONS ===================== */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===================== RESPONSIVE ===================== */
@media (max-width: 1024px) { main.container { padding: 2.5rem; } }
@media (max-width: 768px) {
  main.container { padding: 2rem; }
  .post-content { max-height: 300px; font-size: 0.95rem; line-height: 1.65; }
  h2 { font-size: 1.8rem; }
}
@media (max-width: 480px) {
  main.container { padding: 1.5rem; }
  .post-content { max-height: 240px; font-size: 0.9rem; line-height: 1.55; }
  h2 { font-size: 1.5rem; }
}

</style>

<main class="container">

<% if (!post) { %>
  <div class="alert alert-danger text-center">
    <h3>Post Not Found</h3>
    <a href="/posts" class="btn btn-primary">← Back</a>
  </div>
<% } else { %>

<article class="post-view">
  <h2><%= post.title %></h2>
  <p class="text-muted">
    By <strong><%= post.author?.name || 'Anonymous' %></strong> •
    <%= new Date(post.createdAt).toLocaleString() %>
  </p>

  <% if (post.images?.length) { %>
    <div class="post-images text-center mb-3">
      <% post.images.forEach(img => { %>
        <img src="<%= img %>" class="img-fluid mb-3" style="max-height:400px;">
      <% }) %>
    </div>
  <% } %>

  <!-- SCROLLABLE CONTENT -->
  <div class="post-content">
    <p><%= post.content %></p>
  </div>

  <div class="my-4">
    <button id="likeBtn"
      class="btn <%= user && post.likes?.includes(user._id) ? 'btn-success' : 'btn-outline-primary' %>"
      data-postid="<%= post._id %>">
      ❤️ Like (<span id="likeCount"><%= post.likes?.length || 0 %></span>)
    </button>
  </div>

  <hr>

  <!-- COMMENTS -->
  <section id="commentsSection">
    <h4 class="text-warning">
      💬 Comments (<span id="commentCount"><%= post.comments?.length || 0 %></span>)
    </h4>

    <div class="comment-list mb-3">
      <% post.comments?.forEach(c => { %>
        <div class="comment-item" data-commentid="<%= c._id %>">
          <strong><%= c.author?.name || 'Anonymous' %></strong>
          <p><%= c.content %></p>
          <small><%= new Date(c.createdAt).toLocaleString() %></small>
        </div>
      <% }) %>
    </div>

    <% if (user) { %>
      <textarea class="comment-input form-control mb-2" rows="3"
        placeholder="Write your comment..."></textarea>
      <button class="comment-btn btn btn-primary"
        data-postid="<%= post._id %>">Comment</button>
    <% } else { %>
      <p>Please <a href="/login">login</a> to comment.</p>
    <% } %>
  </section>

  <a href="/posts" class="btn btn-secondary mt-4">← Back to all posts</a>
</article>

<% } %>
</main>

<%- include('../../partials/footer') %>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const likeBtn = document.getElementById("likeBtn");
  const likeCount = document.getElementById("likeCount");

  likeBtn?.addEventListener("click", async () => {
    const postId = likeBtn.dataset.postid;
    const liked = likeBtn.classList.contains("btn-success");
    likeCount.textContent = liked
      ? Number(likeCount.textContent) - 1
      : Number(likeCount.textContent) + 1;

    likeBtn.classList.toggle("btn-success");
    likeBtn.classList.toggle("btn-outline-primary");

    await fetch(`/posts/${postId}/like`, { method: "POST" });
  });
});
</script>
