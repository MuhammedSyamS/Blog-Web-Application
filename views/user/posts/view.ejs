<%- include('../../partials/header', { title: (post && post.title) ? post.title : 'Post Not Found' }) %>

<style>
/* ===== BACKGROUND & STYLES ===== */
body {
  background-image: url("/img/StockCake-Mountain_reading_escape_1762572141.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
  font-family: "Poppins", sans-serif;
  color: #f9f9f9;
}
body::before {
  content: "";
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(2px);
  z-index: -1;
}
main.container {
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  border-radius: 20px;
  padding: 2.5rem;
  margin-top: 3rem;
  color: #fff;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
}
.comment-item {
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.1);
  color: #f9f9f9;
  padding: 0.75rem;
  border-radius: 10px;
  margin-bottom: 0.5rem;
}
.comment-item strong {
  color: #FFD89C;
}
.comment-input {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.2);
}
.comment-input:focus {
  background: rgba(255,255,255,0.2);
  border-color: #FFD89C;
  box-shadow: none;
}
</style>

<main class="container">

  <% if (!post) { %>
    <div class="alert alert-danger text-center mt-5">
      <h3>Post Not Found</h3>
      <p>The post you are looking for might have been removed or doesn’t exist.</p>
      <a href="/posts" class="btn btn-primary mt-3">← Back to all posts</a>
    </div>
  <% } else { %>
    <article class="mb-4 post-view">
      <h2 class="mb-2"><%= post.title %></h2>
      <p class="text-muted">
        By <strong><%= post.author?.name || 'Anonymous' %></strong> |
        <%= new Date(post.createdAt).toLocaleString() %>
      </p>

      <% if (post.images?.length) { %>
        <div class="post-images mb-3 text-center">
          <% post.images.forEach(img => { %>
            <img src="<%= img %>" alt="Post Image" class="img-fluid rounded mb-3" style="max-height: 400px;">
          <% }) %>
        </div>
      <% } %>

      <div class="post-content mb-4">
        <p><%= post.content %></p>
      </div>

      <div class="mb-4">
        <button
          class="btn <%= user && post.likes?.includes(user._id) ? 'btn-success' : 'btn-outline-primary' %>"
          id="likeBtn"
          data-postid="<%= post._id %>"
        >
          <%= user && post.likes?.includes(user._id) ? '❤️ Liked' : '👍 Like' %>
          (<span id="likeCount"><%= post.likes ? post.likes.length : 0 %></span>)
        </button>
      </div>

      <hr>

      <!-- Comments Section -->
      <section id="commentsSection" class="mt-4">
        <h4 class="mb-3 text-warning">💬 Comments (<span id="commentCount"><%= post.comments?.length || 0 %></span>)</h4>

        <div class="comment-list mb-3">
          <% if (post.comments?.length) { %>
            <% post.comments.forEach(comment => { 
                 const loggedUserId = user && (user._id || user.id)?.toString();
                 const commentAuthorId = comment.author?._id?.toString() || comment.author?.toString();
                 const canDelete = loggedUserId && commentAuthorId && (loggedUserId === commentAuthorId || (user && user.role === 'admin'));
            %>
              <div class="comment-item" data-commentid="<%= comment._id %>">
                <p><strong><%= comment.author?.name || 'Anonymous' %></strong></p>
                <p><%= comment.content %></p>
                <small class="text-light"><%= new Date(comment.createdAt).toLocaleString() %></small>

                <% if (canDelete) { %>
                  <button class="comment-delete btn btn-sm btn-danger mt-1">🗑️ Delete</button>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-light">No comments yet. Be the first to comment!</p>
          <% } %>
        </div>

        <% if (user) { %>
          <div class="comment-section">
            <textarea class="comment-input form-control mb-2" placeholder="Write your comment..." rows="3"></textarea>
            <button class="comment-btn btn btn-primary" data-postid="<%= post._id %>">Comment</button>
          </div>
        <% } else { %>
          <p class="mt-3">Please <a href="/login">login</a> to comment.</p>
        <% } %>
      </section>

      <a href="/posts" class="btn btn-secondary mt-4">← Back to all posts</a>
    </article>
  <% } %>
</main>

<%- include('../../partials/footer') %>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const commentList = document.querySelector(".comment-list");
  const commentBtn = document.querySelector(".comment-btn");
  const commentInput = document.querySelector(".comment-input");
  const commentCountEl = document.getElementById("commentCount");
  const likeBtn = document.getElementById("likeBtn");
  const likeCountEl = document.getElementById("likeCount");

  const postId = commentBtn?.dataset.postid || likeBtn?.dataset.postid;

  console.log("Debug: postId = ", postId);

  if (!postId) {
    console.warn("postId missing on buttons/data attributes.");
  }

  // --- Like button handler (delegated via the likeBtn directly) ---
  if (likeBtn && likeCountEl) {
    likeBtn.addEventListener("click", async (event) => {
      event.preventDefault();
      console.log("Like button clicked");

      const currentLikes = parseInt(likeCountEl.textContent, 10) || 0;
      let liked = likeBtn.classList.contains("btn-success");
      console.log("Currently liked? ", liked, " currentLikes = ", currentLikes);

      // Optimistic UI update
      const newLikes = liked ? currentLikes - 1 : currentLikes + 1;
      likeCountEl.textContent = Math.max(0, newLikes);
      likeBtn.classList.toggle("btn-success", !liked);
      likeBtn.classList.toggle("btn-outline-primary", liked);
      likeBtn.textContent = !liked ? `❤️ Liked (${Math.max(0,newLikes)})` : `👍 Like (${Math.max(0,newLikes)})`;

      try {
        const response = await fetch(`/posts/${encodeURIComponent(postId)}/like`, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json"
          }
        });
        const data = await response.json();
        console.log("Like response:", response.status, data);

        if (response.ok && data.success) {
          likeCountEl.textContent = data.likesCount;
          liked = data.liked;
          likeBtn.textContent = liked ? `❤️ Liked (${data.likesCount})` : `👍 Like (${data.likesCount})`;
        } else {
          console.warn("Like toggle failed:", data.message || response.statusText);
          // rollback
          likeCountEl.textContent = currentLikes;
          likeBtn.classList.toggle("btn-success", liked);
          likeBtn.classList.toggle("btn-outline-primary", !liked);
          likeBtn.textContent = liked ? `❤️ Liked (${currentLikes})` : `👍 Like (${currentLikes})`;
        }
      } catch (err) {
        console.error("Error liking post:", err);
        alert("Something went wrong liking the post.");
        // rollback
        likeCountEl.textContent = currentLikes;
        likeBtn.classList.toggle("btn-success", liked);
        likeBtn.classList.toggle("btn-outline-primary", !liked);
        likeBtn.textContent = liked ? `❤️ Liked (${currentLikes})` : `👍 Like (${currentLikes})`;
      }
    });
  } else {
    console.warn("Like button or like count element not found.");
  }

  // --- Add comment handler ---
  if (commentBtn && commentInput && commentList && commentCountEl) {
    commentBtn.addEventListener("click", async (event) => {
      event.preventDefault();
      console.log("Comment button clicked");

      const content = commentInput.value.trim();
      if (!content) {
        alert("Please write a comment before submitting.");
        return;
      }

      commentBtn.disabled = true;

      try {
        const response = await fetch(`/posts/${encodeURIComponent(postId)}/comments`, {
          method: "POST",
          headers: {
            "Accept": "application/json",
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ content })
        });
        const data = await response.json();
        console.log("Add comment response:", response.status, data);

        if (response.ok && data.success && data.comment) {
          const canDelete = true; // assuming current user just posted -> author
          const deleteBtnHtml = canDelete
            ? `<button class="comment-delete btn btn-sm btn-danger mt-1">🗑️ Delete</button>`
            : "";

          const newCommentHtml = `
            <div class="comment-item" data-commentid="${data.comment._id}">
              <p><strong>${data.comment.author}</strong></p>
              <p>${data.comment.content}</p>
              <small class="text-light">${new Date(data.comment.createdAt).toLocaleString()}</small>
              ${deleteBtnHtml}
            </div>
          `;
          commentList.insertAdjacentHTML("afterbegin", newCommentHtml);

          commentInput.value = "";
          const prevCount = parseInt(commentCountEl.textContent, 10) || 0;
          commentCountEl.textContent = prevCount + 1;
        } else {
          console.warn("Failed to add comment:", data.message || response.statusText);
          alert("Could not add comment: " + (data.message || `Status ${response.status}`));
        }
      } catch (err) {
        console.error("Error during comment submission:", err);
        alert("Something went wrong adding your comment. See console for details.");
      } finally {
        commentBtn.disabled = false;
      }
    });
  } else {
    console.warn("One or more comment UI elements not found (button, input, list or count).");
  }

  // --- Delete comment handler (delegated) ---
  if (commentList) {
    commentList.addEventListener("click", async (event) => {
      const target = event.target;
      if (!target.matches(".comment-delete")) {
        return;
      }
      console.log("Comment delete button clicked", target);
      event.preventDefault();

      const commentItem = target.closest(".comment-item");
      const commentId = commentItem?.dataset.commentid;
      if (!commentId) {
        console.warn("commentId missing from comment item for deletion.");
        return;
      }

      const confirmed = confirm("Are you sure you want to delete this comment?");
      if (!confirmed) {
        return;
      }

      target.disabled = true;

      try {
        const response = await fetch(`/posts/${encodeURIComponent(postId)}/comments/${encodeURIComponent(commentId)}`, {
          method: "DELETE",
          headers: {
            "Accept": "application/json"
          }
        });
        const data = await response.json();
        console.log("Delete comment response:", response.status, data);

        if (response.ok && data.success) {
          commentItem.remove();
          const prevCount = parseInt(commentCountEl.textContent, 10) || 0;
          commentCountEl.textContent = Math.max(0, prevCount - 1);
        } else {
          console.warn("Failed to delete comment:", data.message || response.statusText);
          alert("Could not delete comment: " + (data.message || `Status ${response.status}`));
          target.disabled = false;
        }
      } catch (err) {
        console.error("Error deleting comment:", err);
        alert("Something went wrong deleting the comment. See console for details.");
        target.disabled = false;
      }
    });
  } else {
    console.warn("Comment list container not found for delete event delegation.");
  }

});
</script>
