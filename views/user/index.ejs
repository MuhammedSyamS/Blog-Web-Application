<%- include('../partials/header', { title: 'All Posts', user }) %>

<style>
:root {
  --bg-gradient-start: #0f172a;
  --bg-gradient-end: #1e293b;
  --bg-card: rgba(255, 255, 255, 0.05);
  --border-soft: rgba(255, 255, 255, 0.12);
  --accent: #7c7cff;
  --accent-hover: #a5b4fc;
  --like-color: #ff4d6d;
  --text-main: #f8fafc;
  --text-muted: #cbd5f5;
}

body {
  background: radial-gradient(circle at top left, #1e293b, #0f172a 80%);
  font-family: 'Inter', sans-serif;
  color: var(--text-main);
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* Moving animated gradient bubbles */
body::before {
  content: '';
  position: fixed;
  width: 200%;
  height: 200%;
  top: -50%;
  left: -50%;
  background: radial-gradient(circle, rgba(124,124,255,0.1) 0%, transparent 70%);
  animation: floatBubbles 60s linear infinite;
  pointer-events: none;
  z-index: 0;
}

@keyframes floatBubbles {
  0% { transform: rotate(0deg) translateX(0); }
  50% { transform: rotate(180deg) translateX(20%); }
  100% { transform: rotate(360deg) translateX(0); }
}

/* ===== Post Card ===== */
.post-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-soft);
  border-radius: 20px;
  backdrop-filter: blur(16px);
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  margin-bottom: 3rem;
  max-width: 900px;
  margin-left: auto;
  margin-right: auto;
  z-index: 1;
}

.post-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at top right, var(--accent-hover), transparent 70%);
  opacity: 0.12;
  transition: opacity 0.25s ease;
  pointer-events: none;
}

.post-card:hover::after {
  opacity: 0.25;
}

.post-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 15px 40px rgba(124,124,255,0.3);
}

.post-content {
  position: relative;
  z-index: 1;
  padding: 1.5rem;
}

/* ===== Post Title & Meta ===== */
.post-title {
  color: var(--text-main);
  font-weight: 700;
  font-size: 1.7rem;
  margin-bottom: 0.5rem;
  transition: color 0.3s ease, text-shadow 0.3s ease;
}
.post-title:hover {
  color: var(--accent-hover);
  text-shadow: 0 0 8px var(--accent-hover);
}

.post-meta {
  color: var(--text-muted);
  font-size: 0.85rem;
  margin-bottom: 1rem;
}

.post-preview {
  color: var(--text-main);
  line-height: 1.6;
  margin-bottom: 1rem;
}

/* Open post link */
.open-link {
  color: var(--accent);
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;
}
.open-link:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

/* ===== Like Button ===== */
.like-btn {
  min-width: 80px;
  transition: all 0.25s ease;
  background: transparent;
  border: 1px solid var(--like-color);
  color: var(--like-color);
  border-radius: 12px;
}
.like-btn.btn-danger {
  background: linear-gradient(135deg, #ff4d6d, #ff758c);
  color: #fff;
  border: none;
  box-shadow: 0 8px 20px rgba(255,77,109,0.4);
}
.like-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(255,77,109,0.5);
}
.like-btn span.like-count {
  margin-left: 6px;
  font-weight: 600;
}

/* ===== Edit / Delete Buttons ===== */
.btn-warning, .btn-danger {
  border-radius: 12px;
  font-weight: 600;
  padding: 0.35rem 0.8rem;
}
.btn-warning:hover {
  background: linear-gradient(135deg, #7c7cff, #a5b4fc);
}
.btn-danger:hover {
  background: linear-gradient(135deg, #ff4d6d, #ff758c);
}

/* ===== Responsive ===== */
@media (max-width: 768px) {
  .post-card .post-content { padding: 1rem; }
  .post-title { font-size: 1.4rem; }
}
@media (max-width: 480px) {
  .post-title { font-size: 1.1rem; }
  .post-preview { font-size: 0.9rem; }
  .like-btn { width: 100%; margin-top: 0.5rem; }
  .d-flex.justify-content-between { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  .text-end .btn { width: 100%; margin-bottom: 0.5rem; }
}
</style>

<main class="container my-5">
  <div class="text-center mb-5">
    <h1 class="fw-bold display-4 text-light">From Our Writers</h1>
    <p class="text-secondary fs-5">Discover stories, ideas, and experiences from the community</p>
  </div>

  <div class="d-flex justify-content-end mb-4">
    <% if (user) { %>
      <a href="/posts/new" class="btn btn-warning fw-semibold px-4 shadow">+ Create Post</a>
    <% } %>
  </div>

  <% const PREVIEW_LENGTH = 220; %>

  <% if (posts && posts.length > 0) { %>
    <% posts.forEach(post => { %>
      <div class="post-card">
        <% if (post.images?.length) { %>
          <img src="<%= post.images[0] %>" 
               style="width:100%; height:420px; object-fit:cover; border-radius:18px 18px 0 0;">
        <% } %>

        <div class="post-content">
          <h4 class="post-title"><%= post.title %></h4>
          <div class="post-meta">By <%= post.author?.name || 'Unknown' %> • <%= new Date(post.createdAt).toLocaleDateString() %></div>
          <p class="post-preview"><%= post.content
              ? (post.content.length > PREVIEW_LENGTH ? post.content.substring(0, PREVIEW_LENGTH) + '...' : post.content)
              : 'No content available.' %></p>

          <div class="d-flex justify-content-between align-items-center">
            <a href="/posts/<%= post._id %>" class="open-link">Open Post →</a>

            <button class="like-btn btn-sm <%= user && post.likes?.some(id => id.toString() === (user._id || user.id)) ? 'btn-danger' : '' %>"
              data-postid="<%= post._id %>">
              ❤️ <span class="like-count"><%= post.likes?.length || 0 %></span>
            </button>
          </div>

          <% if (user && post.author?._id?.toString() === (user._id || user.id)) { %>
            <div class="text-end mt-3">
              <a href="/posts/edit/<%= post._id %>" class="btn btn-warning me-2">Edit</a>
              <form action="/posts/delete/<%= post._id %>" method="POST" class="d-inline">
                <button class="btn btn-danger">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="text-center text-light mt-5">
      <h4>No posts yet</h4>
      <% if (user) { %>
        <a href="/posts/new" class="open-link">Create the first one</a>
      <% } else { %>
        <a href="/login" class="open-link">Login to create a post</a>
      <% } %>
    </div>
  <% } %>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  document.querySelectorAll(".like-btn").forEach(btn => {
    btn.addEventListener("click", async () => {
      const postId = btn.dataset.postid;
      const likeCountEl = btn.querySelector(".like-count");
      const currentLikes = parseInt(likeCountEl.textContent, 10) || 0;
      const likedBefore = btn.classList.contains("btn-danger");

      likeCountEl.textContent = likedBefore ? currentLikes - 1 : currentLikes + 1;
      btn.classList.toggle("btn-danger", !likedBefore);

      try {
        const res = await fetch(`/posts/${encodeURIComponent(postId)}/like`, {
          method: "POST",
          headers: { "Accept": "application/json", "Content-Type": "application/json" },
          credentials: "include"
        });
        const data = await res.json();
        if (res.ok && data.success) {
          likeCountEl.textContent = data.likesCount;
          btn.classList.toggle("btn-danger", data.liked);
        } else if (res.status === 401) {
          window.location.href = "/login";
        } else {
          likeCountEl.textContent = currentLikes;
          btn.classList.toggle("btn-danger", likedBefore);
        }
      } catch (err) {
        console.error(err);
        likeCountEl.textContent = currentLikes;
        btn.classList.toggle("btn-danger", likedBefore);
        alert("Something went wrong!");
      }
    });
  });
});
</script>
