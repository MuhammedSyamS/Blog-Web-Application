<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= post.title %> · Post Details</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-main: #0b0f19;
      --glass: rgba(255,255,255,0.06);
      --border-soft: rgba(255,255,255,0.12);
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --accent: #6366f1;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at top left, #1a1f36, transparent 45%),
        radial-gradient(circle at bottom right, #0d1226, transparent 45%),
        var(--bg-main);
      color: var(--text-main);
      overflow-x: hidden;
    }

    main {
      max-width: 1100px;
      margin-inline: auto;
    }

    .glass-card {
      background: linear-gradient(
        180deg,
        rgba(255,255,255,0.08),
        rgba(255,255,255,0.02)
      );
      border: 1px solid var(--border-soft);
      border-radius: 22px;
      backdrop-filter: blur(18px);
      box-shadow: 0 30px 80px rgba(0,0,0,.6);
    }

    .page-title {
      font-size: clamp(1.6rem, 4vw, 2rem);
      font-weight: 800;
      background: linear-gradient(90deg, #ffffff, #a5b4fc);
      -webkit-background-clip: text;
      background-clip: padding;
      -webkit-text-fill-color: transparent;
    }

    .meta {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .badge-published {
      background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .badge-draft {
      background: linear-gradient(135deg, #64748b, #475569);
    }

    .image-grid img {
      width: 100%;
      height: 140px;
      object-fit: cover;
      border-radius: 14px;
      border: 1px solid var(--border-soft);
      transition: transform .3s ease, box-shadow .3s ease;
    }

    .image-grid img:hover {
      transform: scale(1.05);
      box-shadow: 0 20px 40px rgba(0,0,0,.6);
    }

    .content-box {
      background: rgba(0,0,0,0.35);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 1.25rem;
      line-height: 1.7;
      overflow-wrap: break-word;
    }

    .btn-icon {
      border: 1px solid var(--border-soft);
      background: transparent;
      color: var(--text-main);
      border-radius: 12px;
      padding: 0.55rem 1rem;
      white-space: nowrap;
    }

    .btn-icon:hover {
      background: rgba(255,255,255,0.08);
    }

    /* =====================
       RESPONSIVE BEHAVIOR
       ===================== */

    @media (max-width: 768px) {
      .header-wrap {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .title-status {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .content-box {
        max-height: 260px; /* SCROLLER */
        overflow-y: auto;
      }

      .content-box::-webkit-scrollbar {
        width: 6px;
      }

      .content-box::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.25);
        border-radius: 10px;
      }
    }

    @media (max-width: 576px) {
      .content-box {
        max-height: 220px;
        font-size: 0.95rem;
      }

      .btn-icon {
        padding: 0.5rem 0.9rem;
      }
    }
  </style>
</head>

<body>

<%- include('../../partials/admin_nav') %>

<main class="container py-4 py-md-5">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4 header-wrap">
    <div>
      <div class="page-title">Post Details</div>
      <div class="meta mt-1">
        by <strong><%= post.author ? post.author.name : 'Unknown' %></strong>
        &nbsp;·&nbsp;
        <%= new Date(post.createdAt).toLocaleString() %>
      </div>
    </div>

    <a href="/admin/posts" class="btn btn-icon">
      <i class="bi bi-arrow-left"></i> Back
    </a>
  </div>

  <!-- Card -->
  <div class="glass-card p-3 p-md-4">

    <!-- Title + Status -->
    <div class="d-flex justify-content-between align-items-center mb-4 title-status">
      <h3 class="fw-bold mb-0"><%= post.title %></h3>
      <span class="badge px-3 py-2 <%= post.status === 'published' ? 'badge-published' : 'badge-draft' %>">
        <%= post.status.toUpperCase() %>
      </span>
    </div>

    <!-- Images -->
    <% if (post.images && post.images.length > 0) { %>
      <div class="row g-3 image-grid mb-4">
        <% post.images.forEach(img => { 
          let src = '';
          if (typeof img === 'string') {
            src = img.startsWith('/uploads') ? img : `/uploads/${img}`;
          } else if (img && img.url) {
            src = img.url.startsWith('/uploads') ? img.url : `/uploads/${img.url}`;
          }
        %>
          <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <img src="<%= src %>" alt="Post Image" loading="lazy">
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- Content -->
    <div class="content-box mb-4">
      <%- post.content %>
    </div>

    <!-- Actions -->
    <div class="d-flex flex-wrap gap-3">
      <a href="/admin/posts/<%= post._id %>/edit" class="btn btn-icon">
        <i class="bi bi-pencil"></i> Edit
      </a>

      <form
        action="/admin/posts/<%= post._id %>?_method=DELETE"
        method="POST"
        onsubmit="return confirm('Delete this post permanently?');"
      >
        <button class="btn btn-icon text-danger">
          <i class="bi bi-trash"></i> Delete
        </button>
      </form>
    </div>

  </div>

</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
  