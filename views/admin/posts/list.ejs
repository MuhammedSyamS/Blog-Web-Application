<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Manage Posts' %></title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-main: #0b0f19;
      --card-bg: rgba(255,255,255,0.06);
      --border-soft: rgba(255,255,255,0.12);
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --accent: #6366f1;
    }

    * { box-sizing: border-box; }

    body {
      font-family: 'Inter', sans-serif;
      background:
        radial-gradient(circle at top left, #1a1f36, transparent 45%),
        radial-gradient(circle at bottom right, #0d1226, transparent 45%),
        var(--bg-main);
      color: var(--text-main);
      overflow-x: hidden;
    }

    main {
      max-width: 1100px;
      margin-inline: auto;
    }

    .page-title {
      font-weight: 800;
      font-size: clamp(1.6rem, 3vw, 2.2rem);
      background: linear-gradient(90deg, #fff, #a5b4fc);
      -webkit-background-clip: text;
      background-clip: padding;
      -webkit-text-fill-color: transparent;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .search-box {
      background: var(--card-bg);
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 0.75rem 1rem;
      color: var(--text-main);
      width: 100%;
    }

    .search-box:focus {
      outline: none;
      border-color: var(--accent);
    }

    .post-card {
      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
      border: 1px solid var(--border-soft);
      border-radius: 20px;
      padding: 1.2rem 1.4rem;
      backdrop-filter: blur(16px);
      box-shadow: 0 25px 70px rgba(0,0,0,0.55);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .post-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 35px 90px rgba(0,0,0,0.7);
    }

    .badge-published {
      background: linear-gradient(135deg, #22c55e, #16a34a);
    }

    .badge-draft {
      background: linear-gradient(135deg, #64748b, #475569);
    }

    .btn-icon {
      border: 1px solid var(--border-soft);
      background: transparent;
      color: var(--text-main);
      border-radius: 10px;
      padding: 0.45rem 0.7rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn-icon:hover {
      background: rgba(255,255,255,0.08);
    }

    .btn-back {
      border-radius: 999px;
      padding: 0.55rem 1.3rem;
      border: 1px solid var(--border-soft);
      color: var(--text-main);
      white-space: nowrap;
    }

    .btn-back:hover {
      background: rgba(255,255,255,0.08);
    }

    /* RESPONSIVE FIXES */

    @media (max-width: 768px) {
      .post-actions {
        justify-content: flex-start;
        margin-top: 0.75rem;
      }
    }

    @media (max-width: 576px) {
      .post-card {
        padding: 1rem 1.1rem;
      }

      .btn-icon {
        padding: 0.55rem 0.8rem;
      }
    }
  </style>
</head>

<body>

<%- include('../../partials/admin_nav') %>

<main class="container py-4 py-md-5">

  <!-- HEADER -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <div class="page-title">
        <i class="bi bi-journal-text"></i> Manage Posts
      </div>
      <div class="subtitle">View, edit, or remove posts</div>
    </div>

    <a href="/admin/dashboard" class="btn btn-back">
      <i class="bi bi-arrow-left"></i> Dashboard
    </a>
  </div>

  <!-- SEARCH -->
  <input
    type="text"
    id="postSearch"
    class="search-box mb-4"
    placeholder="Search by title or author..."
  />

  <!-- POSTS -->
  <div class="row g-4" id="postList">

    <% if (posts && posts.length > 0) { %>
      <% posts.forEach((post, index) => { %>

        <div class="col-12 post-item">
          <div class="post-card">

            <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">

              <!-- LEFT -->
              <div class="flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                  <span class="text-muted small">#<%= index + 1 %></span>
                  <span class="badge <%= post.status === 'published' ? 'badge-published' : 'badge-draft' %> text-uppercase">
                    <%= post.status %>
                  </span>
                </div>

                <div class="fw-semibold fs-5 mb-1">
                  <%= post.title %>
                </div>

                <div class="text-light small">
                  by <%= post.author ? post.author.name : 'Unknown' %> •
                  <%= new Date(post.createdAt).toLocaleDateString() %>
                </div>
              </div>

              <!-- ACTIONS -->
              <div class="d-flex gap-2 post-actions">
                <a href="/admin/posts/<%= post._id %>" class="btn btn-icon" title="View">
                  <i class="bi bi-eye"></i>
                </a>

                <a href="/admin/posts/<%= post._id %>/edit" class="btn btn-icon" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>

                <form
                  action="/admin/posts/<%= post._id %>?_method=DELETE"
                  method="POST"
                  onsubmit="return confirm('Delete this post permanently?');"
                >
                  <button type="submit" class="btn btn-icon text-danger" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>

            </div>

          </div>
        </div>

      <% }) %>
    <% } else { %>
      <div class="col-12 text-center text-muted py-5">
        No posts found
      </div>
    <% } %>

  </div>

</main>

<script>
  document.getElementById('postSearch').addEventListener('input', function () {
    const value = this.value.toLowerCase();
    document.querySelectorAll('.post-item').forEach(item => {
      item.style.display = item.innerText.toLowerCase().includes(value) ? '' : 'none';
    });
  });
</script>

</body>
</html>
