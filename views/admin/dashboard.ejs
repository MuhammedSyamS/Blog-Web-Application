<% title = 'Admin Dashboard' %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Dashboard</title>

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg-main: #0b0f19;
  --bg-card: rgba(255,255,255,0.06);
  --border-soft: rgba(255,255,255,0.12);
  --text-main: #f9fafb;
  --text-muted: #9ca3af;
  --accent: #6366f1;
  --accent-soft: rgba(99,102,241,0.25);
  --success: #22c55e;
  --warning: #fbbf24;
}

body {
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, #141a33, transparent 45%),
    radial-gradient(circle at bottom right, #0d1226, transparent 45%),
    var(--bg-main);
  color: var(--text-main);
  min-height: 100vh;
  margin: 0;
}

/* HEADER */
.dashboard-header {
  text-align: center;
  margin-bottom: 3rem;
}
.dashboard-header h2 {
  font-weight: 800;
  font-size: 2rem;
  background: linear-gradient(90deg,#ffffff,#a5b4fc);
  -webkit-background-clip: text;
   background-clip: padding;
  -webkit-text-fill-color: transparent;
}
.dashboard-header p {
  color: var(--text-muted);
  font-size: 1rem;
}

/* CARDS GRID */
.dashboard-cards, .quick-links {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
  margin-bottom: 3rem;
}

/* Glass Card */
.card-glass {
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  border: 1px solid var(--border-soft);
  border-radius: 22px;
  padding: 2rem;
  position: relative;
  overflow: hidden;
  box-shadow: 0 25px 80px rgba(0,0,0,0.55);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.card-glass::after {
  content:"";
  position:absolute;
  inset:0;
  background: radial-gradient(circle at top right, var(--accent-soft), transparent 55%);
  opacity:0;
  transition:opacity 0.3s ease;
}
.card-glass:hover::after { opacity:1; }
.card-glass:hover { transform: translateY(-8px); box-shadow: 0 25px 60px rgba(0,0,0,0.45); }

/* Icon */
.icon-wrapper {
  font-size: 2.6rem;
  margin-bottom: 1rem;
  color: var(--accent);
}

/* Card Title & Value */
.card-title { font-size:0.75rem; letter-spacing:1.4px; text-transform:uppercase; color: var(--text-muted);}
.card-value { font-size:2.3rem; font-weight:800; margin-top:0.4rem; }

/* Quick Links */
.quick-link-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  border: 1px solid var(--border-soft);
  border-radius: 20px;
  padding: 2rem;
  text-decoration: none;
  color: inherit;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.quick-link-card::after {
  content:"";
  position:absolute;
  inset:0;
  background: linear-gradient(120deg, transparent, var(--accent-soft), transparent);
  opacity:0;
  transition:opacity 0.3s ease;
}
.quick-link-card:hover::after { opacity:1; }
.quick-link-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,0.4); }

.quick-link-icon { font-size:2.2rem; margin-bottom:0.8rem; color:var(--accent);}
.quick-link-title { font-size:1.25rem; font-weight:700; }
.quick-link-card p { color:var(--text-muted); font-size:0.95rem; margin-top:0.4rem; }

/* Responsive */
@media(max-width:768px){
  .dashboard-cards, .quick-links { grid-template-columns: 1fr; }
}
</style>
</head>
<body>



<div class="container py-5">

  <!-- HEADER -->
  <div class="dashboard-header">
    <h2>Admin Dashboard</h2>
    <p>System insights and administrative control center</p>
  </div>

  <!-- STATS CARDS -->
  <div class="dashboard-cards">
    <div class="card-glass text-center">
      <div class="icon-wrapper"><i class="bi bi-people-fill"></i></div>
      <div class="card-title">Total Users</div>
      <div class="card-value"><%= stats.totalUsers %></div>
    </div>

    <div class="card-glass text-center">
      <div class="icon-wrapper" style="color:var(--success);"><i class="bi bi-journal-text"></i></div>
      <div class="card-title">Total Posts</div>
      <div class="card-value"><%= stats.totalPosts %></div>
    </div>

    <div class="card-glass text-center">
      <div class="icon-wrapper" style="color:var(--warning);"><i class="bi bi-hourglass-split"></i></div>
      <div class="card-title">Pending Posts</div>
      <div class="card-value"><%= stats.pendingPosts %></div>
    </div>
  </div>

  <!-- QUICK LINKS -->
  <div class="quick-links">
    <a href="/admin/users" class="quick-link-card">
      <div class="quick-link-icon"><i class="bi bi-person-gear"></i></div>
      <div class="quick-link-title">Manage Users</div>
      <p>Roles, permissions, and access control</p>
    </a>

    <a href="/admin/posts" class="quick-link-card">
      <div class="quick-link-icon"><i class="bi bi-card-list"></i></div>
      <div class="quick-link-title">Manage Posts</div>
      <p>Moderation, review, and publishing workflow</p>
    </a>

    <a href="/admin/settings" class="quick-link-card">
      <div class="quick-link-icon"><i class="bi bi-gear-fill"></i></div>
      <div class="quick-link-title">System Settings</div>
      <p>Configuration, security, and preferences</p>
    </a>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
