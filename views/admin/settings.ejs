<% title = 'Admin Settings' %>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Admin Settings</title>

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg-main: #0b0f19;
  --bg-card: rgba(255,255,255,0.06);
  --border-soft: rgba(255,255,255,0.12);
  --text-main: #f9fafb;
  --text-muted: #9ca3af;
  --accent: #6366f1;
  --accent-soft: rgba(99,102,241,0.25);
  --success: #22c55e;
}

body {
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, #141a33, transparent 45%),
    radial-gradient(circle at bottom right, #0d1226, transparent 45%),
    var(--bg-main);
  color: var(--text-main);
  min-height: 100vh;
  margin: 0;
}

/* Header */
.settings-header {
  text-align: center;
  margin-bottom: 3rem;
}
.settings-header h2 {
  font-weight: 800;
  font-size: 2rem;
  background: linear-gradient(90deg, #ffffff, #a5b4fc);
  -webkit-background-clip: text;
   background-clip: padding;
  -webkit-text-fill-color: transparent;
}
.settings-header p {
  color: var(--text-muted);
  font-size: 1rem;
}

/* Glass Card */
.settings-card {
  max-width: 600px;
  margin: 0 auto 2rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  border: 1px solid var(--border-soft);
  border-radius: 24px;
  padding: 2.5rem;
  box-shadow: 0 30px 80px rgba(0,0,0,0.55);
  backdrop-filter: blur(14px);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.settings-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 40px 100px rgba(0,0,0,0.6);
}

/* Form Labels & Inputs */
.form-label {
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: var(--text-muted);
}
.form-control, .form-check-input {
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-soft);
  color: var(--text-main);
  border-radius: 14px;
  padding: 0.8rem 1rem;
}
.form-control::placeholder {
  color: var(--text-muted);
}
.form-control:focus {
  background: rgba(255,255,255,0.08);
  border-color: var(--accent);
  box-shadow: 0 0 0 0.2rem var(--accent-soft);
  color: var(--text-main);
}

/* Buttons */
.btn-primary {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  border: none;
  border-radius: 999px;
  padding: 0.8rem 1.8rem;
  font-weight: 600;
  box-shadow: 0 15px 35px rgba(99,102,241,0.5);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 20px 45px rgba(99,102,241,0.65);
}

.btn-outline-secondary {
  border: 1px solid var(--border-soft);
  color: var(--text-main);
  border-radius: 999px;
  padding: 0.7rem 1.5rem;
  background: transparent;
}
.btn-outline-secondary:hover {
  background: rgba(255,255,255,0.08);
}

/* Flash Messages */
.alert {
  border-radius: 14px;
  backdrop-filter: blur(10px);
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-soft);
  color: var(--text-main);
}

/* Responsive */
@media(max-width:768px){
  .settings-card { padding: 2rem; margin: 1rem; }
}
</style>
</head>
<body>

<%- include('../partials/admin_nav') %>

<div class="container py-5">

  <!-- Header -->
  <div class="settings-header">
    <h2><i class="bi bi-gear-wide-connected me-2"></i> Admin Settings</h2>
    <p>Manage site configuration, registration policies, and other preferences.</p>
  </div>

  <!-- Flash Messages -->
  <% if (success_msg && success_msg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-2"></i> <%= success_msg[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (error_msg && error_msg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <i class="bi bi-exclamation-triangle me-2"></i> <%= error_msg[0] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Settings Form -->
  <div class="settings-card">
    <form action="/admin/settings" method="POST">
      <div class="mb-4">
        <label for="siteTitle" class="form-label"><i class="bi bi-fonts me-2 text-accent"></i> Site Title</label>
        <input type="text" id="siteTitle" name="siteTitle" class="form-control" placeholder="Enter your site title" value="<%= settings.siteTitle || '' %>" required>
      </div>

      <div class="form-check form-switch mb-4 ps-2">
        <input class="form-check-input" type="checkbox" id="allowRegistrations" name="allowRegistrations" <%= settings.allowRegistrations ? 'checked' : '' %>>
        <label class="form-check-label form-label" for="allowRegistrations">
          <i class="bi bi-person-plus me-2 text-success"></i> Allow New User Registrations
        </label>
      </div>

      <div class="d-grid mt-4">
        <button type="submit" class="btn btn-primary"><i class="bi bi-save2 me-2"></i> Save Settings</button>
      </div>
    </form>
  </div>

  <!-- Back to Dashboard -->
  <div class="text-center mt-4">
    <a href="/admin/dashboard" class="btn btn-outline-secondary px-4">
      <i class="bi bi-arrow-left-circle me-2"></i> Back to Dashboard
    </a>
  </div>

</div>

<%- include('../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
