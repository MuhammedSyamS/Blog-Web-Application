<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit User · Admin</title>

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
:root {
  --bg-main: #0b0f19;
  --card-bg: rgba(255,255,255,0.06);
  --border-soft: rgba(255,255,255,0.12);
  --text-main: #f9fafb;
  --text-muted: #9ca3af;
  --accent: #6366f1;
  --accent-soft: rgba(99,102,241,0.25);
}

body {
  font-family: 'Inter', sans-serif;
  background:
    radial-gradient(circle at top left, #1a1f36, transparent 45%),
    radial-gradient(circle at bottom right, #0d1226, transparent 45%),
    var(--bg-main);
  color: var(--text-main);
  min-height: 100vh;
  margin: 0;
}

/* Glass Card */
.edit-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
  border: 1px solid var(--border-soft);
  border-radius: 24px;
  backdrop-filter: blur(16px);
  box-shadow: 0 25px 70px rgba(0,0,0,0.55);
  padding: 2.5rem 3rem;
  max-width: 720px;
  margin: 2rem auto;
  animation: fadeUp 0.6s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Header */
.page-title {
  font-weight: 800;
  font-size: 2rem;
  background: linear-gradient(90deg,#ffffff,#a5b4fc);
  -webkit-background-clip: text;
  background-clip: padding;
  -webkit-text-fill-color: transparent;
}
.subtitle {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
  text-align: center;
}

/* Form */
.form-label {
  font-size: 0.85rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--text-muted);
}
.form-control, .form-select {
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border-soft);
  color: var(--text-main);
  border-radius: 14px;
  padding: 0.75rem 1rem;
  transition: all 0.2s ease;
}
.form-control::placeholder {
  color: var(--text-muted);
}
.form-control:focus, .form-select:focus {
  background: rgba(255,255,255,0.08);
  border-color: var(--accent);
  box-shadow: 0 0 0 0.2rem var(--accent-soft);
  color: var(--text-main);
}

/* Buttons */
.btn-primary {
  background: linear-gradient(135deg,#6366f1,#4f46e5);
  border: none;
  border-radius: 16px;
  padding: 0.75rem 2rem;
  font-weight: 600;
  box-shadow: 0 12px 30px rgba(99,102,241,0.4);
  transition: all 0.3s ease;
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 40px rgba(99,102,241,0.55);
}
.btn-outline {
  border: 1px solid var(--border-soft);
  border-radius: 16px;
  padding: 0.75rem 1.5rem;
  color: var(--text-main);
  background: transparent;
  transition: all 0.2s ease;
}
.btn-outline:hover {
  background: rgba(255,255,255,0.08);
}

/* Actions layout */
.actions {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}

/* Responsive adjustments */
@media(max-width:768px){
  .edit-card{
    padding: 2rem 1.5rem;
  }
  .page-title{
    font-size: 1.7rem;
  }
  .actions{
    flex-direction: column;
  }
  .btn-primary, .btn-outline{
    width: 100%;
    text-align: center;
  }
}
</style>
</head>
<body>

<%- include('../../partials/admin_nav') %>

<main class="container py-5">
  <div class="edit-card">

    <!-- Header -->
    <div class="text-center">
      <div class="page-title mb-1"><i class="bi bi-pencil-square"></i> Edit User</div>
      <div class="subtitle">Modify account details and permissions</div>
    </div>

    <!-- Form -->
    <form action="/admin/users/<%= user._id %>?_method=PUT" method="POST">

      <div class="mb-4">
        <label class="form-label">Full Name</label>
        <input type="text" class="form-control" name="name" value="<%= user.name %>" required>
      </div>

      <div class="mb-4">
        <label class="form-label">Email Address</label>
        <input type="email" class="form-control" name="email" value="<%= user.email %>" required>
      </div>

      <div class="mb-4">
        <label class="form-label">User Role</label>
        <select class="form-select" name="role" required>
          <option value="user" <%= user.role==='user'?'selected':'' %>>User</option>
          <option value="admin" <%= user.role==='admin'?'selected':'' %>>Administrator</option>
        </select>
      </div>

      <!-- Actions -->
      <div class="actions mt-4">
        <a href="/admin/users" class="btn btn-outline"><i class="bi bi-arrow-left"></i> Back</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Changes</button>
      </div>

    </form>
  </div>
</main>

<%- include('../../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
