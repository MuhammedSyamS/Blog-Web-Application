<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title || 'Manage Users' %></title>

<!-- Bootstrap & Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
  :root {
    --bg-main: #0b0f19;
    --card-bg: rgba(255,255,255,0.05);
    --border-soft: rgba(255,255,255,0.15);
    --text-main: #f9fafb;
    --text-muted: #9ca3af;
    --accent: #6366f1;
    --accent-soft: rgba(99,102,241,0.25);
  }

  body {
    font-family: 'Inter', sans-serif;
    background:
      radial-gradient(circle at top left, #1a1f36, transparent 45%),
      radial-gradient(circle at bottom right, #0d1226, transparent 45%),
      var(--bg-main);
    color: var(--text-main);
  }

  .page-title {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(90deg,#fff,#a5b4fc);
    -webkit-background-clip: text;
    background-clip: padding;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .search-box {
    background: var(--card-bg);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 0.75rem 1rem;
    color: var(--text-main);
    width: 100%;
    margin-bottom: 2rem;
  }
  .search-box:focus {
    outline: none;
    border-color: var(--accent);
  }

  .user-card {
    background: var(--card-bg);
    border: 1px solid var(--border-soft);
    border-radius: 20px;
    padding: 1.25rem 1.5rem;
    backdrop-filter: blur(16px);
    box-shadow: 0 25px 70px rgba(0,0,0,0.55);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .user-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 35px 90px rgba(0,0,0,0.7);
  }

  .badge-role {
    padding: 0.35rem 0.7rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: capitalize;
    color: #fff;
  }
  .badge-role.admin {
    background: linear-gradient(135deg, #ef4444, #b91c1c);
  }
  .badge-role.user {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
  }

  .badge-status {
    padding: 0.35rem 0.7rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: capitalize;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .badge-status.active {
    background: linear-gradient(135deg,#22c55e,#16a34a);
  }
  .badge-status.inactive {
    background: linear-gradient(135deg,#6b7280,#374151);
  }

  .btn-icon {
    border-radius: 12px;
    padding: 0.45rem 0.65rem;
    font-size: 0.9rem;
  }
  .btn-icon:hover {
    transform: translateY(-1px);
    box-shadow: 0 3px 12px rgba(0,0,0,0.2);
  }

  @media (max-width: 768px) {
    .user-card {
      padding: 1rem;
    }
    .d-flex.actions {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }

</style>
</head>
<body>

<%- include('../../partials/admin_nav') %>

<main class="container py-5">

  <!-- Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-4">
    <div>
      <div class="page-title"><i class="bi bi-people-fill"></i> Manage Users</div>
      <div class="subtitle">View and manage all registered users</div>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary">← Back to Dashboard</a>
  </div>

  <!-- Search -->
  <input type="text" id="userSearch" class="search-box" placeholder="Search by name or email...">

  <!-- Users List -->
  <div class="row g-4" id="userList">
    <% if (!users || users.length === 0) { %>
      <div class="col-12 text-center text-muted py-5">
        <i class="bi bi-exclamation-circle me-2"></i> No users found.
      </div>
    <% } else { %>
      <% users.forEach(function(u, index){ %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="user-card d-flex flex-column justify-content-between h-100">

            <div>
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="text-light">#<%= index+1 %></span>
                <span class="badge-role <%= u.role==='admin'?'admin':'user' %>"><%= u.role %></span>
              </div>

              <div class="fw-bold fs-5 mb-1"><%= u.name %></div>
              <div class="text-light mb-2"><%= u.email %></div>

              <div class="badge-status <%= u.isActive?'active':'inactive' %>">
                <i class="bi <%= u.isActive?'bi-check-circle-fill':'bi-x-circle-fill' %>"></i>
                <%= u.isActive?'Active':'Deactivated' %>
              </div>

              <div class="text-light mt-2" style="font-size: 0.85rem;">
                Registered: <%= new Date(u.createdAt).toLocaleDateString() %>
              </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-start gap-2 mt-3 actions flex-wrap">
              <a href="/admin/users/<%= u._id %>" class="btn btn-outline-info btn-icon" title="View">
                <i class="bi bi-eye"></i>
              </a>
              <a href="/admin/users/<%= u._id %>/edit" class="btn btn-outline-warning btn-icon" title="Edit">
                <i class="bi bi-pencil"></i>
              </a>
              <% if(u.isActive){ %>
              <form action="/admin/users/<%= u._id %>/deactivate?_method=PUT" method="POST">
                <button type="submit" class="btn btn-outline-danger btn-icon" title="Deactivate" onclick="return confirm('Deactivate this user?');">
                  <i class="bi bi-person-x"></i>
                </button>
              </form>
              <% } else { %>
              <form action="/admin/users/<%= u._id %>/reactivate?_method=PUT" method="POST">
                <button type="submit" class="btn btn-outline-success btn-icon" title="Reactivate" onclick="return confirm('Reactivate this user?');">
                  <i class="bi bi-person-check"></i>
                </button>
              </form>
              <% } %>
              <form action="/admin/users/<%= u._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-outline-danger btn-icon" title="Delete" onclick="return confirm('Permanently delete this user?');">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </div>

          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

</main>
 <%- include('../../partials/footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // Live search filter
  document.getElementById('userSearch').addEventListener('input', function(){
    const value = this.value.toLowerCase();
    document.querySelectorAll('#userList .user-card').forEach(card=>{
      const text = card.innerText.toLowerCase();
      card.parentElement.style.display = text.includes(value)?'':'none';
    });
  });
</script>

</body>
</html>
